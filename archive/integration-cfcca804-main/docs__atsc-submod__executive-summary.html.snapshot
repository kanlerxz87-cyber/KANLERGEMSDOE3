code, pre { font-family: var(--mono); font-size: 0.86rem; }
code { background: #f1f5f9; padding: 2px 6px; border-radius: 5px; word-break: break-all; }
pre {
  background: #0f172a; color: #f8fafc; padding: 14px 16px; border-radius: 10px;
